# =============================================================================
# LLM keys — two different companies (do not mix)
# =============================================================================
#
# GROQ (fast Llama, etc.) — https://console.groq.com/keys
#   Keys almost always start with: gsk_
#   .env:
#     VANTAGE_LLM=groq
#     GROQ_API_KEY=gsk_...
#     GROQ_MODEL=llama-3.3-70b-versatile
#
# GROK (xAI chat model) — https://console.x.ai/
#   NOT the same as Groq. Do NOT put a gsk_ key here.
#   .env:
#     VANTAGE_LLM=grok
#     GROK_API_KEY=<from console.x.ai>
#     GROK_MODEL=grok-3-mini
#   (Alias: XAI_API_KEY / XAI_MODEL)
#
# If several keys exist, always set VANTAGE_LLM to groq OR grok so the right one is used.
# =============================================================================

# VANTAGE_LLM=groq
# GROQ_API_KEY=

# VANTAGE_LLM=grok
# GROK_API_KEY=

# --- Other providers ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Local (no cloud keys) ---
# VANTAGE_LLM=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434
